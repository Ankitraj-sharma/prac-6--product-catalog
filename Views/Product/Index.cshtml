@model ProductCatalogApp.Models.ProductCatalogViewModel
@{
    ViewData["Title"] = "Product Catalog";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Product Catalog
        </h2>
        <p class="text-muted mb-0">Browse, filter, and manage your complete store inventory</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> Add New Product
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <!-- Search Keyword -->
            <div class="col-lg-5 col-md-6">
                <label class="form-label small fw-semibold text-muted">Search Products</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@Model.SearchString" class="form-control bg-light border-start-0" 
                           placeholder="Search by name, description, category..." />
                </div>
            </div>

            <!-- Category Filter -->
            <div class="col-lg-3 col-md-3 col-sm-6">
                <label class="form-label small fw-semibold text-muted">Category</label>
                <select name="category" class="form-select bg-light">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (cat == Model.SelectedCategory)
                        {
                            <option value="@cat" selected="selected">@cat</option>
                        }
                        else
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <!-- Sort By -->
            <div class="col-lg-2 col-md-3 col-sm-6">
                <label class="form-label small fw-semibold text-muted">Sort By</label>
                <select name="sortOrder" class="form-select bg-light">
                    <option value="">Default (ID)</option>
                    <option value="price_asc" selected="@(Model.SortOrder == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SortOrder == "price_desc")">Price: High to Low</option>
                    <option value="name_asc" selected="@(Model.SortOrder == "name_asc")">Name: A to Z</option>
                    <option value="name_desc" selected="@(Model.SortOrder == "name_desc")">Name: Z to A</option>
                    <option value="rating_desc" selected="@(Model.SortOrder == "rating_desc")">Highest Rated</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <div class="col-lg-2 col-md-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-funnel"></i> Apply
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchString) || !string.IsNullOrWhiteSpace(Model.SelectedCategory) || !string.IsNullOrWhiteSpace(Model.SortOrder))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Results Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted small">
        Showing <strong>@Model.TotalCount</strong> @(Model.TotalCount == 1 ? "product" : "products")
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCategory))
        {
            <span>in <strong>@Model.SelectedCategory</strong></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SearchString))
        {
            <span>matching "<em>@Model.SearchString</em>"</span>
        }
    </span>
</div>

<!-- Product Grid -->
@if (!Model.Products.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
        <div class="text-muted mb-3">
            <i class="bi bi-inbox fs-1"></i>
        </div>
        <h4 class="fw-bold text-dark">No Products Found</h4>
        <p class="text-secondary mb-4">No catalog items matched your search and filter criteria.</p>
        <div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 me-2">Reset Filters</a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Add New Product</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card bg-white position-relative">
                    <!-- Image & Badges -->
                    <div class="position-relative bg-light" style="height: 200px;">
                        <img src="@product.ImageUrl" class="w-100 h-100" style="object-fit: cover;" 
                             alt="@product.Name" onerror="this.src='https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600&auto=format&fit=crop&q=80'" />
                        
                        <!-- Rating Badge -->
                        <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2 rounded-pill px-2 py-1 small">
                            <i class="bi bi-star-fill text-warning"></i> @product.Rating
                        </span>

                        <!-- Stock Badge -->
                        <div class="position-absolute bottom-0 start-0 m-2">
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-check-circle-fill me-1"></i> In Stock (@product.StockQuantity)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small">
                                    <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column p-3">
                        <span class="badge bg-light text-secondary border align-self-start mb-2 small">@product.Category</span>
                        <h6 class="card-title fw-bold text-dark text-truncate mb-1" title="@product.Name">@product.Name</h6>
                        <p class="card-text text-muted small mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                            @product.Description
                        </p>

                        <div class="mt-auto pt-2 border-top">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fs-5 fw-bold text-primary">$@product.Price.ToString("F2")</span>
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    Details
                                </a>
                            </div>
                            
                            <!-- Action links -->
                            <div class="d-flex justify-content-end gap-1 pt-2 border-top">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1" title="Edit Product">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger btn-sm rounded-pill px-2 py-1" title="Delete Product">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
