@model ProductCatalogApp.Models.Product
@{
    ViewData["Title"] = Model.Name + " - Details";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Catalog</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
    <div class="row g-0">
        <!-- Image Column -->
        <div class="col-lg-6 bg-light d-flex align-items-center justify-content-center p-4">
            <div class="position-relative w-100 text-center" style="max-height: 480px;">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-4 shadow-sm"
                     style="max-height: 440px; width: auto; object-fit: cover;" 
                     onerror="this.src='https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600&auto=format&fit=crop&q=80'" />
            </div>
        </div>

        <!-- Info Column -->
        <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                        @Model.Category
                    </span>
                    <span class="badge bg-dark bg-opacity-75 rounded-pill px-3 py-2">
                        <i class="bi bi-star-fill text-warning me-1"></i> @Model.Rating / 5.0
                    </span>
                </div>

                <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

                <div class="d-flex align-items-baseline gap-3 mb-4">
                    <span class="display-6 fw-bold text-primary">$@Model.Price.ToString("F2")</span>
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i> In Stock (@Model.StockQuantity units available)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">
                            <i class="bi bi-x-circle-fill me-1"></i> Out of Stock
                        </span>
                    }
                </div>

                <div class="mb-4">
                    <h6 class="text-uppercase text-muted fw-bold small">Product Description</h6>
                    <p class="text-secondary leading-relaxed">@Model.Description</p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="row g-2 small text-muted">
                        <div class="col-6"><strong>Product ID:</strong> #@Model.Id</div>
                        <div class="col-6"><strong>Category:</strong> @Model.Category</div>
                        <div class="col-6"><strong>Stock Level:</strong> @Model.StockQuantity</div>
                        <div class="col-6"><strong>Status:</strong> @(Model.IsAvailable ? "Available" : "Unavailable")</div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2 pt-3 border-top">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary d-inline-flex align-items-center gap-1 rounded-pill px-4">
                    <i class="bi bi-pencil-square"></i> Edit Product
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger d-inline-flex align-items-center gap-1 rounded-pill px-4">
                    <i class="bi bi-trash"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 rounded-pill px-4 ms-auto">
                    <i class="bi bi-arrow-left"></i> Back to Catalog
                </a>
            </div>
        </div>
    </div>
</div>
