@model ProductCatalogApp.Models.Product
@{
    ViewData["Title"] = "Delete - " + Model.Name;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Catalog</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.Name</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="card-header bg-danger text-white p-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    <div>
                        <h4 class="mb-0 fw-bold">Delete Product</h4>
                        <p class="mb-0 small text-white-50">Please confirm product removal from catalog</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                    <i class="bi bi-shield-exclamation fs-4"></i>
                    <div>
                        <strong>Warning:</strong> Are you sure you want to permanently delete this product? This action cannot be undone.
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 mb-4">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-3 shadow-sm"
                         style="width: 80px; height: 80px; object-fit: cover;"
                         onerror="this.src='https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=600&auto=format&fit=crop&q=80'" />
                    <div>
                        <span class="badge bg-secondary-subtle text-secondary small mb-1">@Model.Category</span>
                        <h5 class="fw-bold text-dark mb-1">@Model.Name</h5>
                        <div class="text-primary fw-bold">$@Model.Price.ToString("F2")</div>
                    </div>
                </div>

                <div class="small text-muted mb-4">
                    <p class="mb-1"><strong>Product ID:</strong> #@Model.Id</p>
                    <p class="mb-1"><strong>Stock Quantity:</strong> @Model.StockQuantity</p>
                    <p class="mb-0"><strong>Description:</strong> @Model.Description</p>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                            <i class="bi bi-trash-fill me-1"></i> Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
